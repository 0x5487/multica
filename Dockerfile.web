# --- Dependencies ---
FROM node:22-alpine AS deps

RUN corepack enable && corepack prepare pnpm@10.28.2 --activate

WORKDIR /app

# Copy workspace config and ALL package.json files for dependency resolution
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json turbo.json .npmrc ./
COPY apps/web/package.json apps/web/
COPY apps/svelte-web/package.json apps/svelte-web/
COPY packages/core/package.json packages/core/
COPY packages/ui/package.json packages/ui/
COPY packages/ui-svelte/package.json packages/ui-svelte/
COPY packages/views/package.json packages/views/
COPY packages/tsconfig/package.json packages/tsconfig/
COPY packages/eslint-config/package.json packages/eslint-config/

RUN pnpm install --frozen-lockfile

# --- Build ---
FROM node:22-alpine AS builder

RUN corepack enable && corepack prepare pnpm@10.28.2 --activate

WORKDIR /app

# Copy installed dependencies
COPY --from=deps /app ./

# Copy source
COPY package.json turbo.json pnpm-workspace.yaml ./
COPY apps/svelte-web/ apps/svelte-web/
COPY packages/ packages/

# Re-link and install any missing devDeps (ensure online for this step if needed, but deps should cover it)
RUN pnpm install --frozen-lockfile

# Build the Svelte web app
RUN pnpm --filter @multica/svelte-web build

# --- Runtime ---
FROM node:22-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production

RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 sveltejs

# Copy build output and node_modules for production
COPY --from=builder /app/apps/svelte-web/build ./build
COPY --from=builder /app/apps/svelte-web/package.json ./package.json
COPY --from=builder /app/node_modules ./node_modules

USER sveltejs

EXPOSE 3000
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

# Start SvelteKit adapter-node server
CMD ["node", "build/index.js"]
